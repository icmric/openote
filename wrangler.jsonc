// openote.org — a Worker with static assets.
//
// Deliberately a Worker rather than Cloudflare Pages: Pages would serve the
// HTML perfectly well, but the page needs one dynamic thing (the newest
// release), and doing that at the edge instead of in every visitor's browser
// is the whole justification. See worker/index.js for the reasoning.
//
// Deploy:  npx wrangler deploy          (CI does this on push to master)
// Preview: npx wrangler dev             (serves site/ on localhost:8787)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openote-site",
  "main": "worker/index.js",

  // Pin the runtime date rather than tracking "latest". A Worker whose
  // runtime semantics can change under it between deploys is a Worker that
  // can break without anyone touching the code.
  "compatibility_date": "2026-07-01",

  // The asset directory holds ONLY what should be publicly served. The Worker
  // script lived in site/ at first and was therefore uploaded as an asset too
  // — openote.org/worker.js would have served its own source. Harmless, since
  // the repository is public, but a directory whose contents are "the website"
  // should not also contain the thing serving it.
  "assets": {
    "directory": "./site",

    // The binding the Worker calls for anything that is not /api/latest.
    "binding": "ASSETS",

    // Requests hit the Worker FIRST, always. The default
    // ("asset first, Worker only on a miss") would work here too, but it makes
    // routing depend on which filenames happen to exist in site/ — so adding a
    // file called `api` would silently take over the API route. Explicit
    // routing costs one invocation per asset request and removes that class of
    // surprise entirely.
    "run_worker_first": true,

    // /about serves about.html; a missing path 404s rather than serving
    // index.html for everything, which would make a typo look like the home
    // page.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // The browser demo, which is its own Worker with its own 56 MB of assets —
  // see wrangler.demo.jsonc for why it is not simply a folder in site/.
  //
  // A binding rather than a Cloudflare route, because a route does not work
  // here: openote.org is a Custom Domain of THIS Worker and a Custom Domain
  // takes the whole hostname, so `openote.org/demo*` pointed at the demo was
  // configured, visible, and never reached. worker/index.js has the detail.
  //
  // This makes `openote-demo` a deploy-time dependency of the website: if it
  // has never been deployed, this deploy fails with an unresolved binding.
  // That is the right way round — the alternative is a site that deploys
  // happily with a /demo that 404s.
  "services": [
    { "binding": "DEMO", "service": "openote-demo" }
  ],

  "observability": {
    // Logs are off by default and are the only way to find out that
    // /api/latest has been 503ing for a week.
    "enabled": true
  }
}
