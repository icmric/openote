{"v":1,"dev":"01a156ca-631f-7da8-8242-eb90a7dcca66","seq":22,"lc":22,"ts":1793013545870,"enc":"none","op":"block.set","d":{"pageId":"01a109b0-6ac4-72a7-9415-e9ad3f687dcd","block":{"absorbedIds":[],"access":null,"content":{"autoWidth":false,"text":"# The page is a canvas\nJust click anywhere and start typing! \nThe canvas will expand seamlessly whenever it needs to, ensuring you will never run out of space even during the most frantic of note taking sessions!"},"createdAt":1791164876219,"frameId":null,"h":null,"id":"01a109bf-05bb-75db-9ae4-6669d57a1eb8","placement":"snapped","rotation":0.0,"type":"text","updatedAt":1791165045273,"w":267.1405273437499,"x":44.0,"y":336.0,"z":10}}}
{"v":1,"dev":"01a156ca-631f-7da8-8242-eb90a7dcca66","seq":23,"lc":23,"ts":1793013545870,"enc":"none","op":"block.set","d":{"pageId":"01a109b0-6ac4-72a7-9415-e9ad3f687dcd","block":{"absorbedIds":[],"access":null,"content":{"autoWidth":false,"text":"## Already familiar with markdown?\nGreat! Openote will interpret whatever markdown you throw at it and cleanly display it right here in the editor, no need for a separate viewer!"},"createdAt":1791165053191,"frameId":null,"h":null,"id":"01a109c1-b907-7123-90e7-9041453e4520","placement":"snapped","rotation":0.0,"type":"text","updatedAt":1791165209058,"w":356.7427734374995,"x":44.0,"y":552.0,"z":12}}}
{"v":1,"dev":"01a156ca-631f-7da8-8242-eb90a7dcca66","seq":24,"lc":24,"ts":1793013545870,"enc":"none","op":"block.set","d":{"pageId":"01a109b0-6ac4-72a7-9415-e9ad3f687dcd","block":{"absorbedIds":[],"access":null,"content":{"autoWidth":false,"text":"## And one for the programmers"},"createdAt":1791165257682,"frameId":null,"h":null,"id":"01a109c4-d7d2-7e70-9872-0aeb30f03cdb","placement":"snapped","rotation":0.0,"type":"text","updatedAt":1791165266226,"w":329.90029296874945,"x":72.0,"y":744.0,"z":13}}}
{"v":1,"dev":"01a156ca-631f-7da8-8242-eb90a7dcca66","seq":25,"lc":25,"ts":1793013545870,"enc":"none","op":"block.set","d":{"pageId":"01a109b0-6ac4-72a7-9415-e9ad3f687dcd","block":{"absorbedIds":[],"access":null,"content":{"autoWidth":false,"text":"You can write code in one of 18 different languages right here in the editor! The built in syntax highlighter makes writing readable notes for programming classes the easiest its ever been!"},"createdAt":1791165270643,"frameId":null,"h":null,"id":"01a109c5-0a73-7f87-acf6-cdb7c7ede118","placement":"snapped","rotation":0.0,"type":"text","updatedAt":1791165418282,"w":424.0000000000001,"x":72.0,"y":792.0,"z":14}}}
{"v":1,"dev":"01a156ca-631f-7da8-8242-eb90a7dcca66","seq":26,"lc":26,"ts":1793013545870,"enc":"none","op":"block.set","d":{"pageId":"01a109b0-6ac4-72a7-9415-e9ad3f687dcd","block":{"absorbedIds":[],"access":null,"content":{"language":"python","languagePicked":true,"source":"# a pretty cool function which does some stuff\n\ndef add_two_numbers(num1, num2):\n    result = num1 + num2\n    return result"},"createdAt":1791165424237,"frameId":null,"h":null,"id":"01a109c7-626d-7b51-b8b6-24caa490da2c","placement":"snapped","rotation":0.0,"type":"code","updatedAt":1791165540830,"w":400.0,"x":72.0,"y":912.0,"z":16}}}
