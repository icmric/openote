{"v":1,"dev":"01a156ca-631f-7da8-8242-eb90a7dcca66","seq":13,"lc":13,"ts":1793013545870,"enc":"none","op":"block.set","d":{"pageId":"01a109b0-6ac4-72a7-9415-e9ad3f687dcd","block":{"absorbedIds":[],"access":null,"content":{"autoWidth":false,"text":"Openote is the most feature rich, open-source note taking app around!"},"createdAt":1791163925057,"frameId":null,"h":null,"id":"01a109b0-8241-7ca6-b2bf-df9fa9d2daaa","placement":"snapped","rotation":0.0,"type":"text","updatedAt":1791164010504,"w":330.8326171875008,"x":48.0,"y":96.0,"z":0}}}
{"v":1,"dev":"01a156ca-631f-7da8-8242-eb90a7dcca66","seq":14,"lc":14,"ts":1793013545870,"enc":"none","op":"block.set","d":{"pageId":"01a109b0-6ac4-72a7-9415-e9ad3f687dcd","block":{"absorbedIds":[],"access":null,"content":{"autoWidth":false,"text":"This is just a demo version of the app. Have a poke around and try it out, no changes here will be saved. When your ready, head back over to [openote.org](https://openote.org) and download it! You can import your entire ontenote notebook so you loose nothing in the transition "},"createdAt":1791164021606,"frameId":null,"h":null,"id":"01a109b1-fb66-7ae5-9e66-2666f180934b","placement":"snapped","rotation":0.0,"type":"text","updatedAt":1791166050841,"w":339.2000000000007,"x":44.0,"y":168.0,"z":1}}}
{"v":1,"dev":"01a156ca-631f-7da8-8242-eb90a7dcca66","seq":15,"lc":15,"ts":1793013545870,"enc":"none","op":"block.set","d":{"pageId":"01a109b0-6ac4-72a7-9415-e9ad3f687dcd","block":{"absorbedIds":[],"access":null,"content":{"autoWidth":false,"text":"# Maths\nOpenote supports a large array of typed maths, enabling easy, clean note taking during even advanced maths classes"},"createdAt":1791164088217,"frameId":null,"h":null,"id":"01a109b2-ff99-7936-988a-d6da8c5972d6","placement":"snapped","rotation":0.0,"type":"text","updatedAt":1791164145662,"w":420.8581054687504,"x":432.0,"y":240.0,"z":2}}}
