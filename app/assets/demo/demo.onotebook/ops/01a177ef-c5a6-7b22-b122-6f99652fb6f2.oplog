{"v":1,"dev":"01a177ef-c5a6-7b22-b122-6f99652fb6f2","seq":26,"lc":57,"ts":1793016079466,"enc":"none","op":"block.set","d":{"pageId":"01a16325-3e02-73f8-898a-4b2e22ef65e9","block":{"absorbedIds":[],"access":null,"content":{"text":"Openote supports most common image types, including SVG!\n  Either insert them via the tab or just drag and drop them directly onto the canvas, openote can handle either!\n  Video is also supported through the same means\n\nOpenote also allows you to drop in an excel spreadsheet directly onto any page\n  Note that styling and formulas are not carried over, only the values of each cell\n  Also note that it may sometimes struggle a little with large spreadsheets, although it will still take them!\n\nGot some other random file no one has heard of before?\n  You can always drag and drop it onto the canvas, if Openote can't figure out what to do with it, it will simply display the name and allow you to attempt to open it with the default app and download the file locally"},"createdAt":1792664766102,"frameId":null,"h":null,"id":"01a16325-8695-764d-ba84-fcc120f712bb","placement":"snapped","rotation":0.0,"type":"text","updatedAt":1792665158577,"w":640.0,"x":48.0,"y":96.0,"z":0}}}
