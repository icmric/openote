  "onboardingImportRunning": "Keep going — this runs in the background, and the card in the corner will say when it's done.",
  "@onboardingImportRunning": {"description": "Reassurance under the progress spinner: the user does not have to wait."},
  "onboardingImportDone": "Your notebook is ready",
  "@onboardingImportDone": {"description": "Shown when the OneNote import has finished successfully."},

