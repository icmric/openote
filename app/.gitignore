# Build and tool output.
.dart_tool/
build/

# Generated by `flutter pub get`, and it says so in its own first line ("This
# is a generated file; do not edit or check into version control"). It records
# ABSOLUTE pub-cache paths, so it differs on every machine that touches it —
# it was tracked despite this rule, and churned on every checkout as a result.
.flutter-plugins
.flutter-plugins-dependencies

# Editor.
.idea/
*.iml

# The desktop runner projects (windows/, linux/, macos/) are deliberately NOT
# listed here. They were, and they are also tracked — which meant every rule
# below applied to files git was already following, and any NEW file added to
# one of them was invisible to `git status` and silently left out of commits.
# That is not hypothetical for this project: the CMake hook that builds the
# Rust core, the plugin registrants, and the bundled pdfium all live in those
# directories. Each of them carries Flutter's own .gitignore covering the parts
# that really are generated (flutter/ephemeral/, Pods/, xcuserdata/), which is
# the right granularity and is already working.

# Platforms this project does not build for yet (PLAT-3). If you add one,
# delete its line here FIRST — otherwise `flutter create` will generate the
# folder and git will never mention it.
ios/
android/

# `web/` came off this list in v1.0.2 for the browser demo, and the warning
# above is why it is hand-written rather than generated: a throwaway
# `flutter create --platforms=web` on this repo also stripped pdfium_flutter
# from all three desktop plugin registrants. See web/README.md.

# UI screenshot harness output (test/ui_screenshots_test.dart). Review
# artifacts, not goldens: font rasterisation differs per machine, so committing
# them would fail the comparison everywhere except the machine that made them.
test/goldens/
test-results.json

# `flutter gen-l10n` writes this report of messages a language is missing.
# It is regenerated on every run and its content is a fact about the .arb
# files, which ARE tracked — so it has nothing to say that a diff of those
# does not. The generated `L` class under lib/l10n/gen is deliberately NOT
# ignored: see the reasoning in l10n.yaml.
l10n-untranslated.txt

# **A notebook's live log directory, wherever one lands in the tree.**
# Opening a `.onote` makes the folder it sits in that notebook's log directory
# — so opening `assets/demo/demo.onote` in place pointed a real notebook at
# this repository and it began writing ops and blobs here. The asset is meant
# to be copied into a workspace and opened from there; `assets/demo/README.md`
# now says so. This is the net under that instruction, because the instruction
# did not hold the first time it mattered.
*.onotebook/
# The same thing one level down: a log directory's own contents, if one is
# ever created directly in the tree rather than inside a `.onotebook`.
assets/**/ops/
assets/**/manifest.json
